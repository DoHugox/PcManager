# VNServerSentinel (PcManager) - File cấu hình mẫu (.env.example)
# Đổi tên file này thành .env trên máy của bạn và điền thông tin thực tế

# 1. Token của Telegram Bot (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Chat ID của riêng bạn (Lấy từ @userinfobot trên Telegram)
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# 3. Mã PIN bảo mật khi thực hiện các lệnh nhạy cảm
ADMIN_PIN=1234

# 4. Link Heartbeat kiểm tra sập nguồn (https://healthchecks.io)
HEARTBEAT_URL=https://hc-ping.com/your-uuid-here

# 5. Kho GitHub phục vụ tính năng Auto-Update từ xa
GITHUB_REPO=DoHugox/PcManager
AUTO_UPDATE_ENABLED=true

# 6. Chu kỳ kiểm tra IP và phần cứng (giây)
CHECK_INTERVAL_SECONDS=60
